[Unit]
Description=AUSTRO OS API (native arm64)
Documentation=https://github.com/Devmraustro/austro-os
# The API must see PostgreSQL, Redis, RabbitMQ and the network before it can
# run its startup verification. Ordering is a best-effort cold-boot guard:
# the application itself still performs authoritative connectivity checks and
# fails fast when a dependency is missing.
After=network-online.target postgresql.service redis-server.service rabbitmq-server.service
Wants=network-online.target postgresql.service redis-server.service rabbitmq-server.service

[Service]
Type=simple
User=austro
Group=austro
# Read before privileges drop; file stays owner root, mode 0600.
EnvironmentFile=/etc/austro/austro.env
WorkingDirectory=/opt/austro/current
ExecStart=/opt/austro/current/main

# The API terminates with a signal; systemd must not kill -9 it before the
# 75s in-flight drain has had a chance to finish.
TimeoutStopSec=90

Restart=on-failure
RestartSec=3

# Hardening: the process needs no privileged operations and no writes outside
# the (read-only) release tree, so the traditional systemd sandbox is safe.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=false
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadOnlyPaths=/opt/austro/current

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target