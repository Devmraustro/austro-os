# AUSTRO OS — native ARM64 deployment environment
#
# Copy this file to /etc/austro/austro.env on the VM and replace every
# change-me-* value BEFORE starting the application. The application validates
# the file on boot (config.LoadStrict) and refuses to start with any
# placeholder left in place, which is the safety property you want: a mistake
# here is a loud start failure, never a silently insecure deployment.
#
#   create /etc/austro directory and copy this file:
#     sudo install -d /etc/austro
#     sudo install -m 0600 -o root -g root deploy/native/austro.env.example \
#       /etc/austro/austro.env
#
#   then edit /etc/austro/austro.env (prefer full random hex secrets):
#     openssl rand -hex 32        # PostgreSQL / Redis / RabbitMQ / JWT secrets
#
# The file must remain owner root, mode 0600. systemd reads it before dropping
# privileges, so this is safe with the services running as user "austro".
# The scripts in deploy/native/ read the same file (override the path with
# AUSTRO_ENV_FILE=/path/to/other.env).

# ----------------------------------------------------------------------------
# Runtime identity
# ----------------------------------------------------------------------------
AUSTRO_ENV=production

# The API binds loopback only. nginx is the sole public listener and proxies to
# this address. 127.0.0.1 (not "localhost") is deliberate: the address must
# pass the configuration's insecure-placeholder check, and loopback binding
# keeps the API off every non-loopback interface.
AUSTRO_SERVER_ADDR=127.0.0.1:8080

# Public host name used by the API for external links and by the healthcheck
# when it verifies the HTTPS proxy. Replace with the VM's public host name or
# IP once TLS is in place.
AUSTRO_PUBLIC_HOSTNAME=change-me-public-hostname

# ----------------------------------------------------------------------------
# PostgreSQL (owner + unprivileged runtime roles)
# ----------------------------------------------------------------------------
# Schema owner DSN. The "austro" role is created by bootstrap-ubuntu24.sh with
# LOGIN CREATEROLE NOSUPERUSER and owns the "austro" database. PostgreSQL keeps
# row-level security ON for tables the runtime role reads/writes; row level
# security is automatically skipped for a table's owner, so application traffic
# must NEVER run on this DSN.
#
# Password characters are safer drawn from hex or base64url: the DSN is parsed
# by net/url, so a ":" or "@" inside the password would corrupt the parse.
AUSTRO_POSTGRES_DSN=postgres://austro:change-me-owner-password@127.0.0.1:5432/austro?sslmode=disable

# Unprivileged application runtime DSN. MUST differ from the owner DSN above;
# the configuration rejects an identical pair. bootstrap-ubuntu24.sh creates
# the "austro_app" role and the application provisions its password.
AUSTRO_POSTGRES_RUNTIME_DSN=postgres://austro_app:change-me-runtime-password@127.0.0.1:5432/austro?sslmode=disable

# Needed by deploy/native scripts (backup/restore/monitor) to query as the
# runtime role over 127.0.0.1 with scram-sha-256 authentication.
AUSTRO_POSTGRES_RUNTIME_PASSWORD=change-me-runtime-password

# ----------------------------------------------------------------------------
# Redis (loopback, requirepass)
# ----------------------------------------------------------------------------
# bootstrap-ubuntu24.sh renders this password into /etc/redis/redis.conf and
# binds Redis to 127.0.0.1 with protected-mode enabled.
AUSTRO_REDIS_ADDR=127.0.0.1:6379
AUSTRO_REDIS_PASSWORD=change-me-redis-password

# ----------------------------------------------------------------------------
# RabbitMQ (loopback, dedicated user on the default vhost)
# ----------------------------------------------------------------------------
# bootstrap-ubuntu24.sh creates the "austro" user with full permissions on the
# default vhost "/" and removes the guest user. The trailing "/" is the default
# vhost. Password characters are limited to URI-safe letters and digits.
AUSTRO_RABBITMQ_URL=amqp://austro:change-me-rabbitmq-password@127.0.0.1:5672/

# Queue the API writes to and the worker consumes.
AUSTRO_RABBITMQ_QUEUE=austro.events

# ----------------------------------------------------------------------------
# Authentication (JWT)
# ----------------------------------------------------------------------------
# Two independent secrets, each >= 32 bytes (2x SHA-256 length for HS256), and
# they MUST differ. openssl rand -hex 32 gives a 64-character hex string.
AUSTRO_JWT_SECRET=change-me-jwt-secret-thirty-two-bytes-or-more-at-least
AUSTRO_JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-thirty-two-bytes-or-more

# ----------------------------------------------------------------------------
# Founder bootstrap (optional until the first /api/auth/bootstrap call)
# ----------------------------------------------------------------------------
# Both must be present together, otherwise the configuration fails validation.
# The password must be at least the application's minimum founder password
# length and never a placeholder. Log in once via /api/auth/bootstrap then
# consider rotating this file's founder credentials down.
AUSTRO_FOUNDER_USERNAME=austro
AUSTRO_FOUNDER_PASSWORD=change-me-founder-password-at-least-16-chars-long

# ----------------------------------------------------------------------------
# AI provider — deterministic stub (no external network, no credentials)
# ----------------------------------------------------------------------------
# Selecting a real backend requires its own endpoint and credential, supplied
# by the operator. Keep the stub backend unless a real provider for your case
# is CONFIGURATION REQUIRED; supplying AI settings while the stub is selected
# is rejected by validation.
AUSTRO_AI_BACKEND=stub
# AUSTRO_AI_MODEL=
# AUSTRO_AI_BASE_URL=
# AUSTRO_AI_API_KEY=

# ----------------------------------------------------------------------------
# Publishing — deterministic stub (no external network, no credentials)
# ----------------------------------------------------------------------------
AUSTRO_PUBLISH_BACKEND=stub
# AUSTRO_PUBLISH_WEBHOOK_URL=
# AUSTRO_PUBLISH_TOKEN=
# AUSTRO_PUBLISH_IDEMPOTENCY_FIELD=
# AUSTRO_PUBLISH_MAX_ATTEMPTS=5
# AUSTRO_PUBLISH_RETRY_BACKOFF_BASE=1s
# AUSTRO_PUBLISH_RETRY_BACKOFF_MAX=5m

# ----------------------------------------------------------------------------
# deploy/native script options (used by healthcheck/backup/restore/monitor)
# ----------------------------------------------------------------------------
# PostgreSQL cluster name (Ubuntu default).
AUSTRO_PG_CLUSTER=16/main
# Retention: number of daily backups to keep on the VM.
AUSTRO_BACKUP_RETENTION_DAYS=7
# Directory (created by bootstrap) that holds the backups.
AUSTRO_BACKUP_DIR=/var/backups/austro