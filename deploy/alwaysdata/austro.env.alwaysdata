# AUSTRO OS — AlwaysData Production Environment
#
# Copy this file to ~/austro/austro.env and fill in real values.
# NEVER commit actual secrets to version control.
#
# Chmod 600 after filling in secrets.
#
# Classification:
#   REQUIRED              no default exists; the process exits at startup
#                         (config.LoadStrict) without it.
#   CONFIGURATION REQUIRED the system runs without it, but the named capability
#                          does not work until you supply it.
#   OPTIONAL              safe to omit; a documented behaviour applies.
#   SAFE DEFAULT          a value the system picks for you and may run with.

# ---------------------------------------------------------------------------
# PRODUCTION SECRETS — REQUIRED
# ---------------------------------------------------------------------------

# PostgreSQL owner credential. Used ONLY to bootstrap the schema, create the
# runtime and admin roles, and apply migrations. The API and worker connect
# with this credential at startup, apply the (idempotent) bootstrap, and close
# the owner pool before serving a single request.
# Format: postgres://austro:<PASSWORD>@postgresql-austro.alwaysdata.net:5432/austro_os?sslmode=require
AUSTRO_POSTGRES_DSN=postgres://austro:<OWNER_PASSWORD>@postgresql-austro.alwaysdata.net:5432/austro_os?sslmode=require

# PostgreSQL runtime credential. This is the identity that actually serves
# request traffic. Must differ from the owner password: PostgreSQL applies
# neither ENABLE nor FORCE row level security to a table's owner, so an
# owner connection would enforce no workspace isolation at all while looking
# correctly configured.
AUSTRO_POSTGRES_RUNTIME_DSN=postgres://austro_app:<RUNTIME_PASSWORD>@postgresql-austro.alwaysdata.net:5432/austro_os?sslmode=require

# PostgreSQL admin credential. Used for organization-level operations and
# audit chain access. Must have separate credentials from the runtime role.
AUSTRO_POSTGRES_ADMIN_DSN=postgres://austro_app_admin:<ADMIN_PASSWORD>@postgresql-austro.alwaysdata.net:5432/austro_os?sslmode=require

# Redis credential. Redis holds workspace memory and is published only on the
# internal AlwaysData network; the application fails to connect without this.
AUSTRO_REDIS_PASSWORD=<REDIS_PASSWORD>

# RabbitMQ broker credential. Used both to provision the broker and to build
# the AMQP URL the API and worker dial.
AUSTRO_RABBITMQ_PASSWORD=<RABBITMQ_PASSWORD>

# Token signing keys. Minimum 32 bytes each (HS256 is designed for a key at
# least as long as its hash output — RFC 7518 §3.2); shorter values are
# rejected at startup. The two MUST differ: a shared key would let a refresh
# token be presented as an access token.
AUSTRO_JWT_SECRET=<JWT_SECRET_32_BYTES_HEX>
AUSTRO_JWT_REFRESH_SECRET=<JWT_REFRESH_SECRET_32_BYTES_HEX>

# The single founder identity, created by POST /api/auth/bootstrap. Both
# values must be supplied together; the password must be at least 16 bytes
# and must not be a placeholder. Until it is set, the bootstrap endpoint is
# disabled.
AUSTRO_FOUNDER_USERNAME=<FOUNDER_USERNAME>
AUSTRO_FOUNDER_PASSWORD=<FOUNDER_PASSWORD_MIN_16_CHARS>

# ---------------------------------------------------------------------------
# PRE-PROVISIONED ROLE MODE — REQUIRED FOR ALWAYSDATA
# ---------------------------------------------------------------------------

# When true, the bootstrap expects the runtime and admin roles to already
# exist in the database with correct attributes (NOSUPERUSER, NOBYPASSRLS,
# NOCREATEROLE, NOCREATEDB, LOGIN). The bootstrap will NOT create/alter these
# roles or modify their passwords. It will FAIL FAST if they don't exist
# or have incorrect attributes.
AUSTRO_POSTGRES_PREPROVISIONED_ROLES=true

# ---------------------------------------------------------------------------
# DATABASE — REQUIRED
# ---------------------------------------------------------------------------

# The three-principal topology is the security model, not an implementation
# detail (see docs/production-configuration.md):
#
#   owner   AUSTRO_POSTGRES_DSN          creates schema, policies and roles
#   runtime AUSTRO_POSTGRES_RUNTIME_DSN  serves every request
#   admin   AUSTRO_POSTGRES_ADMIN_DSN    founder org-level + audit chain only
#
# NOT SUPPORTED: running the API or worker on the owner DSN as its serving
# identity. The application rejects a runtime DSN equal to the owner DSN, and
# verifies against the live database that the runtime role is not a superuser,
# does not hold BYPASSRLS and owns no protected table — exiting if any is true.
#
# These DSNs use the AlwaysData PostgreSQL host with TLS.
# Do NOT use localhost or 127.0.0.1 — the database is on a separate host.

# SAFE DEFAULT austro — the database name on AlwaysData.
AUSTRO_POSTGRES_DB=austro_os

# SAFE DEFAULT austro_app — the unprivileged role the application serves on.
AUSTRO_POSTGRES_RUNTIME_USER=austro_app

# SAFE DEFAULT austro_app_admin — the narrow organization-level role.
AUSTRO_POSTGRES_ADMIN_USER=austro_app_admin

# ---------------------------------------------------------------------------
# REDIS — REQUIRED
# ---------------------------------------------------------------------------

# AlwaysData Redis service host and port.
AUSTRO_REDIS_ADDR=services-austro.alwaysdata.net:8300

# ---------------------------------------------------------------------------
# RABBITMQ — REQUIRED
# ---------------------------------------------------------------------------

# AlwaysData RabbitMQ service. The vhost is 'austro_dz'.
AUSTRO_RABBITMQ_URL=amqp://austro:<RABBITMQ_PASSWORD>@rabbitmq-austro.alwaysdata.net:5672/austro_dz
AUSTRO_RABBITMQ_QUEUE=austro.events

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------

# AlwaysData service port. The API binds to this port.
# AlwaysData assigns port 8301 for native services.
AUSTRO_SERVER_ADDR=[::]:8301

# SAFE DEFAULT production. This value does not change application behaviour;
# it is recorded in startup logs so an operator can see which environment
# a process believes it is running in.
AUSTRO_ENV=production

# OPTIONAL. The workspace the process defaults to when a call carries no
# workspace context. SAFE DEFAULT default.
AUSTRO_WORKSPACE_ID=default

# ---------------------------------------------------------------------------
# EXTERNAL SERVICE ADAPTERS
# ---------------------------------------------------------------------------

# CONFIGURATION REQUIRED in production. The stub is NOT shipped uncommented
# here on purpose: with AUSTRO_ENV=production below, selecting a stub adapter is
# refused at startup (config.LoadStrict). A stub answers every request
# successfully without contacting a real service, so a production deployment
# left on one would serve traffic, answer /health/ready, and perform no real
# work, with nothing in the system reporting it.
#
# For a deliberately offline production-shaped stack (demo, rehearsal, a site
# with no egress) set the commented AUSTRO_ALLOW_STUB_BACKENDS=true further
# below and select the stubs explicitly.
#
# AI provider boundary
#   stub              -> offline deterministic adapter (no real work; refused
#                        in production unless the exemption is set)
#   local             -> keyless OpenAI-compatible endpoint (model + base url
#                        required; api key OPTIONAL)
#   openai-compatible -> real OpenAI-compatible HTTP endpoint (model/base url/
#                        api key CONFIGURATION REQUIRED)
# AUSTRO_AI_BACKEND=openai-compatible
# AUSTRO_AI_MODEL=
# AUSTRO_AI_BASE_URL=
# AUSTRO_AI_API_KEY=
# OPTIONAL per-workspace cap on AI operations (0 = no ceiling). SAFE DEFAULT 0.
# AUSTRO_AI_USAGE_LIMIT_PER_WORKSPACE=0

# Publishing delivery boundary
#   stub         -> offline deterministic adapter (refused in production unless
#                   the exemption is set)
#   generic-http -> real generic HTTP delivery endpoint (webhook url/token
#                   CONFIGURATION REQUIRED)
# AUSTRO_PUBLISH_BACKEND=generic-http
# AUSTRO_PUBLISH_WEBHOOK_URL=
# AUSTRO_PUBLISH_TOKEN=
# OPTIONAL provider-specific idempotency field; omitted means the adapter
# derives a deterministic key without attaching a provider field.
# AUSTRO_PUBLISH_IDEMPOTENCY_FIELD=
# OPTIONAL delivery retry budget. Omitting them means a single attempt and the
# adapter's default backoff (0 = adapter default, never "no retry").
# AUSTRO_PUBLISH_MAX_ATTEMPTS=
# AUSTRO_PUBLISH_RETRY_BACKOFF_BASE=
# AUSTRO_PUBLISH_RETRY_BACKOFF_MAX=

# ---------------------------------------------------------------------------
# AI EXECUTION TRANSPORT -- CONFIGURATION REQUIRED
# ---------------------------------------------------------------------------
# How a claimed AI retry reaches the worker. The dispatcher runs inside the API
# process and the worker is a separate AlwaysData service, so the queue name
# below is the only thing that makes the two meet. AlwaysData provides a real
# RabbitMQ service (AUSTRO_RABBITMQ_URL above), so the broker-backed transport
# is the correct value here and is also what production refuses to run without.
#
#   stub     -> logs each fenced dispatch and reports success, delivering
#               nothing (refused in production unless the exemption is set)
#   rabbitmq -> publishes each claimed retry durably to the execution queue
AUSTRO_EXECUTION_TRANSPORT_BACKEND=rabbitmq

# The queue the dispatcher publishes to and the worker consumes. Both processes
# read this same variable and default to austro.executions, so renaming the
# queue is a one-line change here. It must match on both sides.
AUSTRO_EXECUTION_QUEUE=austro.executions

# CONFIGURATION REQUIRED. The comma-separated workspace UUIDs the dispatcher
# sweeps. With none set, the dispatcher would start, connect and then never
# dispatch anything, so production refuses to start instead. Take these from the
# workspaces this deployment actually serves; they are never hardcoded in source.
# AUSTRO_EXECUTION_WORKSPACE_IDS=

# OPTIONAL dispatch/lease pacing. SAFE DEFAULTS shown. The heartbeat and the
# provider-call window must each stay strictly under the lease; a violation is a
# hard startup failure, not a clamped value.
# AUSTRO_EXECUTION_LEASE_TTL=60s
# AUSTRO_EXECUTION_HEARTBEAT_INTERVAL=20s
# AUSTRO_EXECUTION_WINDOW=50s
# AUSTRO_EXECUTION_SWEEP_INTERVAL=5s
# AUSTRO_EXECUTION_RETRY_BACKOFF_BASE=2s
# AUSTRO_EXECUTION_RETRY_BACKOFF_MAX=2m

# The exemption from every "refused in production" rule above. Leave it false
# (or absent) for a real deployment. Set it to true ONLY for a deliberately
# offline production-shaped stack, so the decision is visible in this file
# instead of being a hardcoded rule nobody can see. An unparseable value is
# rejected at startup rather than read as consent.
AUSTRO_ALLOW_STUB_BACKENDS=false

# ---------------------------------------------------------------------------
# DEPLOYMENT LAYER (read by deploy/alwaysdata/ scripts, never by the Go app)
# ---------------------------------------------------------------------------

# CONFIGURATION REQUIRED — TLS. The AlwaysData Web reverse proxy terminates
# HTTPS. The API serves HTTP on port 8301; AlwaysData Web terminates TLS.
# AUSTRO_TLS_CERT_DIR=~/austro/tls
# AUSTRO_TLS_CERT_FILE=fullchain.pem
# AUSTRO_TLS_KEY_FILE=privkey.pem

# CONFIGURATION REQUIRED — the public hostname the proxy serves.
# No default is provided on purpose: a wrong value either serves the wrong
# site or fails certificate issuance.
# AUSTRO_PUBLIC_HOSTNAME=app.example.com

# OPTIONAL — Caddy automatic TLS (if using Caddy instead of AlwaysData Web).
# The ACME account contact address is CONFIGURATION REQUIRED when caddy
# profile is used.
# AUSTRO_ACME_EMAIL=ops@example.com

# OPTIONAL — the host ports the proxy publishes. SAFE DEFAULTS 80 and 443.
# Port 80 must stay reachable for the HTTP->HTTPS redirect and for ACME HTTP-01.
# AUSTRO_HTTP_PORT=80
# AUSTRO_HTTPS_PORT=443

# OPTIONAL — select the reverse proxy implementation.
# SAFE DEFAULT: AlwaysData Web (native reverse proxy).
# AUSTRO_PROXY_SERVICE=alwaysdata-web

# OPTIONAL — the compose/env file the operator scripts read. SAFE DEFAULT
# .env.production.
# AUSTRO_ENV_FILE=~/austro/austro.env

# OPTIONAL — scripts/healthcheck.sh skips the proxy checks when set to 1.
# Used by CI smoke runs that bring up the stack without a proxy.
# AUSTRO_HEALTHCHECK_SKIP_PROXY=0

# BACKUPS — OPTIONAL. Local backup directory and retention.
# AUSTRO_BACKUP_DIR=~/austro/backups
# AUSTRO_BACKUP_RETENTION_DAYS=14

# BACKUPS — CONFIGURATION REQUIRED to enable off-host copies. S3 upload is
# attempted ONLY when a bucket is explicitly configured; when it is unset the
# backup stays local and the script says so. Requires the `aws` CLI.
# AUSTRO_BACKUP_S3_BUCKET=
# AUSTRO_BACKUP_S3_PREFIX=austro-os/
# OPTIONAL AWS region for the upload; the AWS CLI also reads AWS_REGION.
# AUSTRO_BACKUP_S3_REGION=

# ---------------------------------------------------------------------------
# MONITORING & ALERTING — read by scripts/monitor.sh, never by the Go app.
# Documented in docs/monitoring-and-alerting.md. The defaults below match
# the script's own, so an unset value means the same thing to the script.
# ---------------------------------------------------------------------------

# OPTIONAL — the queue depth at which the monitor reports a backlog.
# AUSTRO_QUEUE_BACKLOG_THRESHOLD=100

# OPTIONAL — error-level lines allowed in the worker's latest log window
# before the monitor reports a failure. SAFE DEFAULT 0.
# AUSTRO_MONITOR_WORKER_ERROR_LIMIT=0

# OPTIONAL — the newest local backup must be no older than this for the
# monitor to report it fresh. SAFE DEFAULT 24 (hours).
# AUSTRO_BACKUP_MAX_AGE_HOURS=24

# OPTIONAL — set to 1 to skip the proxy checks, used by CI runs that bring
# up the stack without a proxy. SAFE DEFAULT 0.
# AUSTRO_MONITOR_SKIP_PROXY=0

# ALERTING — CONFIGURATION REQUIRED for push alerting. When set, and the
# monitor finds at least one failing signal, it POSTs a small JSON alert to
# this webhook (debounced, so a sustained failure pages once, not every
# minute). A service that cannot page an operator is unmonitored.
# AUSTRO_ALERT_WEBHOOK_URL=https://hooks.example.com/austro-alerts

# OPTIONAL — minimum seconds between alerts for the same failure.
# SAFE DEFAULT 3600 (one hour).
# AUSTRO_ALERT_MIN_INTERVAL_SECONDS=3600

# OPTIONAL — directory that holds the alert debounce state file.
# AUSTRO_ALERT_STATE_DIR=/tmp/austro-monitor

# RESTORE — OPTIONAL. scripts/restore.sh refuses to run destructively unless
# this is exactly `yes`. It exists so an unattended run cannot wipe a
# database by accident.
# AUSTRO_RESTORE_CONFIRM=no