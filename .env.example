# AUSTRO OS Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit actual secrets to version control

# Server configuration
AUSTRO_SERVER_ADDR=0.0.0.0:8080

# PostgreSQL configuration
AUSTRO_POSTGRES_DSN=postgres://austro:austro@localhost:5432/austro?sslmode=disable

# Redis configuration
AUSTRO_REDIS_ADDR=localhost:6379
# Required: the compose Redis runs with requirepass, and the application reads
# the same value. CONFIGURATION_REQUIRED before `docker compose up`.
AUSTRO_REDIS_PASSWORD=change-me

# PostgreSQL password used by docker-compose to initialise the server and build
# the default DSN. CONFIGURATION_REQUIRED before `docker compose up`.
AUSTRO_POSTGRES_PASSWORD=change-me
# Password for the application runtime database role (austro_app). This is the
# role the API and worker actually connect as; the owner credential above is
# used only to bootstrap and migrate. The two must differ: PostgreSQL applies no
# row level security to a table's owner, so running traffic as the owner would
# silently enforce no workspace isolation. Required by docker-compose.
AUSTRO_POSTGRES_RUNTIME_PASSWORD=change-me
# Optional overrides. When AUSTRO_POSTGRES_RUNTIME_DSN is unset it is derived
# from AUSTRO_POSTGRES_DSN using AUSTRO_POSTGRES_RUNTIME_USER (default
# austro_app), so a local run needs no extra configuration.
#AUSTRO_POSTGRES_RUNTIME_USER=austro_app
#AUSTRO_POSTGRES_RUNTIME_DSN=postgres://austro_app:runtime-password@localhost:5432/austro?sslmode=disable
#AUSTRO_POSTGRES_ADMIN_USER=austro_app_admin

# RabbitMQ configuration
AUSTRO_RABBITMQ_URL=amqp://austro:austro@localhost:5672
# Credentials the compose broker is created with. CONFIGURATION_REQUIRED.
AUSTRO_RABBITMQ_USER=austro
AUSTRO_RABBITMQ_PASSWORD=change-me

# JWT authentication
# CONFIGURATION_REQUIRED. docker-compose no longer supplies a default: a
# committed signing secret would let anyone who has read this repository forge
# tokens for a deployment that used it. Both must be at least 32 bytes, which
# is the minimum key length HS256 is designed for (RFC 7518 §3.2); shorter
# values are rejected at startup by the fail-fast validator.
AUSTRO_JWT_SECRET=change-me-in-production-min-32-chars
AUSTRO_JWT_REFRESH_SECRET=change-me-in-production-min-32-chars

# Founder bootstrap
# These configure the single founder identity created by POST /api/auth/bootstrap.
# Both must be supplied together; until then the bootstrap endpoint is disabled.
# The password must never be a placeholder. CONFIGURATION_REQUIRED before the
# first bootstrap in any real environment.
AUSTRO_FOUNDER_USERNAME=founder
AUSTRO_FOUNDER_PASSWORD=change-me-to-a-strong-founder-password

# Environment
AUSTRO_ENV=development

# ---------------------------------------------------------------------------
# External service adapters (integration boundaries)
# ---------------------------------------------------------------------------
# These select the adapter used at each integration boundary. The default
# values below run fully offline (deterministic, no external calls, no
# credentials). Selecting a real backend is CONFIGURATION_REQUIRED: the
# corresponding settings must be supplied securely or startup fails fast
# (LoadStrict). NEVER commit real credentials; provide them through the secret
# manager / deployment environment.

# AI provider boundary
#   stub              -> offline deterministic adapter (default, no config needed)
#   local             -> keyless OpenAI-compatible endpoint (model + base url
#                        required; api key OPTIONAL - a locally hosted or
#                        in-house model server usually needs no credential, so
#                        the whole system stays runnable with no paid account)
#   openai-compatible -> real OpenAI-compatible HTTP endpoint (model/base url/
#                        api key required and CONFIGURATION_REQUIRED)
AUSTRO_AI_BACKEND=stub
# AUSTRO_AI_MODEL=
# AUSTRO_AI_BASE_URL=
# AUSTRO_AI_API_KEY=
# Optional per-workspace cap on AI operations (0 = no ceiling)
# AUSTRO_AI_USAGE_LIMIT_PER_WORKSPACE=0

# Publishing delivery boundary
#   stub        -> offline deterministic adapter (default, no config needed)
#   generic-http -> real generic HTTP delivery endpoint (webhook url/token
#                   required and CONFIGURATION_REQUIRED)
AUSTRO_PUBLISH_BACKEND=stub
# AUSTRO_PUBLISH_WEBHOOK_URL=
# AUSTRO_PUBLISH_TOKEN=
