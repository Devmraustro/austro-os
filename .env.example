# AUSTRO OS Environment Configuration
#
# Copy this file, fill in real values, and keep the copy out of version
# control. NEVER commit actual secrets.
#
#   local development : cp .env.example .env
#   production        : cp .env.example .env.production   (then use
#                       scripts/deploy.sh, which refuses to deploy while any
#                       REQUIRED value is still a placeholder)
#
# ---------------------------------------------------------------------------
# CLASSIFICATION LEGEND
# ---------------------------------------------------------------------------
#   REQUIRED              no default exists; the process exits at startup
#                         (config.LoadStrict) without it. Production compose
#                         additionally refuses to start.
#   CONFIGURATION REQUIRED the system runs without it, but the named capability
#                         does not work until you supply it. Never silently
#                         defaulted in production.
#   OPTIONAL              safe to omit; a documented behaviour applies.
#   SAFE DEFAULT          a value the system picks for you and may run with.
#   DEVELOPMENT ONLY      acceptable locally, NOT acceptable in production.
#   NOT SUPPORTED         deliberately unimplemented; do not expect it to work.
#
# ---------------------------------------------------------------------------
# PRODUCTION SECRETS — REQUIRED
# ---------------------------------------------------------------------------
# Every value in this block must be replaced before a production deployment.
# Placeholders are rejected twice: docker-compose uses `:?` so a missing value
# fails the compose parse, and the application's fail-fast validator rejects
# anything containing a known placeholder ("change-me" and friends) or a
# loopback host. scripts/deploy.sh checks placeholders and minimum lengths
# before it starts anything.
#
# Generate with: openssl rand -hex 32

# PostgreSQL owner credential. Used ONLY to bootstrap the schema, create the
# runtime and admin roles, and apply migrations. The API and worker connect
# with this credential at startup, apply the (idempotent) bootstrap, and close
# the owner pool before serving a single request.
AUSTRO_POSTGRES_PASSWORD=change-me-postgres-owner-password

# Password for the unprivileged runtime role (austro_app). This is the identity
# that actually serves request traffic. It must differ from the owner password:
# PostgreSQL applies neither ENABLE nor FORCE row level security to a table's
# owner, so an owner connection would enforce no workspace isolation at all
# while looking correctly configured.
AUSTRO_POSTGRES_RUNTIME_PASSWORD=change-me-runtime-password

# Redis credential. Redis holds workspace memory and is published only on the
# internal network; the application fails to connect without this.
AUSTRO_REDIS_PASSWORD=change-me-redis-password

# RabbitMQ broker credential. Used both to provision the broker and to build the
# AMQP URL the API and worker dial.
AUSTRO_RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Token signing keys. Minimum 32 bytes each (HS256 is designed for a key at
# least as long as its hash output — RFC 7518 §3.2); shorter values are rejected
# at startup. The two MUST differ: a shared key would let a refresh token be
# presented as an access token.
AUSTRO_JWT_SECRET=change-me-in-production-min-32-chars
AUSTRO_JWT_REFRESH_SECRET=change-me-in-production-min-32-chars

# The single founder identity, created by POST /api/auth/bootstrap. Both values
# must be supplied together; the password must be at least 16 bytes and must not
# be a placeholder. Until it is set, the bootstrap endpoint is disabled.
# scripts/deploy.sh requires both for a production deployment, because a
# deployment with no organization-level principal cannot be administered.
AUSTRO_FOUNDER_USERNAME=founder
AUSTRO_FOUNDER_PASSWORD=change-me-to-a-strong-founder-password

# ---------------------------------------------------------------------------
# DATABASE — REQUIRED
# ---------------------------------------------------------------------------
# The three-principal topology is the security model, not an implementation
# detail (see docs/production-configuration.md):
#
#   owner   AUSTRO_POSTGRES_DSN          creates schema, policies and roles
#   runtime AUSTRO_POSTGRES_RUNTIME_DSN  serves every request
#   admin   AUSTRO_POSTGRES_ADMIN_USER   founder org-level + audit chain only
#
# NOT SUPPORTED: running the API or worker on the owner DSN as its serving
# identity. The application rejects a runtime DSN equal to the owner DSN, and
# verifies against the live database that the runtime role is not a superuser,
# does not hold BYPASSRLS and owns no protected table — exiting if any is true.
#
# In production these DSNs are DERIVED by docker-compose.production.yml from the
# parts above (owner user, password, database name, the `postgres` service name
# and sslmode=disable), because the compose network is a private bridge. Set
# them here only to override that derivation (for example a managed database
# with TLS: append `?sslmode=require`).
#
# CONFIGURATION REQUIRED (production): leave these UNSET unless you are
# overriding. The DEVELOPMENT ONLY example below is what a local .env uses:
#AUSTRO_POSTGRES_DSN=postgres://austro:austro@localhost:5432/austro?sslmode=disable
#AUSTRO_POSTGRES_RUNTIME_DSN=postgres://austro_app:change-me-runtime-password@localhost:5432/austro?sslmode=disable

# SAFE DEFAULT austro — the database and role the postgres container is
# initialised with, and the name the compose file derives the DSN from.
#AUSTRO_POSTGRES_DB=austro
#AUSTRO_POSTGRES_USER=austro

# SAFE DEFAULT austro_app — the unprivileged role the application serves on.
#AUSTRO_POSTGRES_RUNTIME_USER=austro_app

# SAFE DEFAULT <runtime role>_admin — the narrow organization-level role. Only
# set this to change the name, never to point it at the runtime role.
#AUSTRO_POSTGRES_ADMIN_USER=austro_app_admin

# ---------------------------------------------------------------------------
# REDIS — REQUIRED
# ---------------------------------------------------------------------------
# SAFE DEFAULT in the production compose: redis:6379, the internal service name.
# AUSTRO_REDIS_ADDR must not resolve to a loopback address, and a value
# containing one is rejected at startup.
#AUSTRO_REDIS_ADDR=redis:6379

# ---------------------------------------------------------------------------
# RABBITMQ — REQUIRED
# ---------------------------------------------------------------------------
# SAFE DEFAULT austro — SAFE DEFAULT austro.events for the queue.
#
# Both are commented out on purpose and leaving them unset is safe: the compose
# file and every operator script apply the same defaults shown here, so an unset
# value cannot mean two different things to two different components. That is
# deliberate — the healthcheck once read the user without a default, and `set -u`
# aborted it mid-run with an "unbound variable" that pointed at RabbitMQ instead
# of at the missing default.
#AUSTRO_RABBITMQ_USER=austro
#AUSTRO_RABBITMQ_QUEUE=austro.events
# Derived by the production compose from the user/password parts above:
#AUSTRO_RABBITMQ_URL=amqp://austro:change-me-rabbitmq-password@rabbitmq:5672/

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
# SAFE DEFAULT 0.0.0.0:8080. The production compose keeps the API on the private
# compose network only; the reverse proxy is the sole ingress.
#AUSTRO_SERVER_ADDR=0.0.0.0:8080

# SAFE DEFAULT production in the production compose. This value does not change
# application behaviour; it is recorded in startup logs so an operator can see
# which environment a process believes it is running in.
#AUSTRO_ENV=production

# OPTIONAL. The workspace the process defaults to when a call carries no
# workspace context. SAFE DEFAULT default.
#AUSTRO_WORKSPACE_ID=default

# ---------------------------------------------------------------------------
# EXTERNAL SERVICE ADAPTERS
# ---------------------------------------------------------------------------
# These select the adapter used at each integration boundary. The default values
# run fully offline (deterministic, no external calls, no credentials), so the
# whole system is deployable with no paid account and no egress. Selecting a
# real backend is CONFIGURATION REQUIRED: the corresponding settings must be
# supplied or startup fails fast (config.LoadStrict).
#
# Note the strictness both ways: supplying external settings while a stub
# backend is selected is itself rejected, so a configured credential can never
# be silently ignored.

# AI provider boundary
#   stub              -> offline deterministic adapter (SAFE DEFAULT, no config)
#   local             -> keyless OpenAI-compatible endpoint (model + base url
#                        required; api key OPTIONAL — a locally hosted or
#                        in-house model server usually needs no credential)
#   openai-compatible -> real OpenAI-compatible HTTP endpoint (model/base url/
#                        api key CONFIGURATION REQUIRED)
AUSTRO_AI_BACKEND=stub
# AUSTRO_AI_MODEL=
# AUSTRO_AI_BASE_URL=
# AUSTRO_AI_API_KEY=
# OPTIONAL per-workspace cap on AI operations (0 = no ceiling). SAFE DEFAULT 0.
# AUSTRO_AI_USAGE_LIMIT_PER_WORKSPACE=0

# Publishing delivery boundary
#   stub         -> offline deterministic adapter (SAFE DEFAULT, no config)
#   generic-http -> real generic HTTP delivery endpoint (webhook url/token
#                   CONFIGURATION REQUIRED)
AUSTRO_PUBLISH_BACKEND=stub
# AUSTRO_PUBLISH_WEBHOOK_URL=
# AUSTRO_PUBLISH_TOKEN=
# OPTIONAL provider-specific idempotency field; omitted means the adapter
# derives a deterministic key without attaching a provider field.
# AUSTRO_PUBLISH_IDEMPOTENCY_FIELD=
# OPTIONAL delivery retry budget. Omitting them means a single attempt and the
# adapter's default backoff (0 = adapter default, never "no retry").
# AUSTRO_PUBLISH_MAX_ATTEMPTS=
# AUSTRO_PUBLISH_RETRY_BACKOFF_BASE=
# AUSTRO_PUBLISH_RETRY_BACKOFF_MAX=

# ---------------------------------------------------------------------------
# DEPLOYMENT LAYER (read by docker-compose.production.yml and scripts/*, never
# by the Go application). Documented in docs/production-configuration.md.
# ---------------------------------------------------------------------------

# CONFIGURATION REQUIRED — TLS. The reverse proxy terminates HTTPS, so a
# certificate and key must be reachable at the paths below. AUSTRO_TLS_CERT_DIR
# is a HOST directory bind-mounted read-only into the proxy container.
#AUSTRO_TLS_CERT_DIR=./deploy/tls
#AUSTRO_TLS_CERT_FILE=fullchain.pem
#AUSTRO_TLS_KEY_FILE=privkey.pem

# CONFIGURATION REQUIRED — the public hostname the proxy serves and the Caddy
# variant requests a certificate for. No default is provided on purpose: a wrong
# value either serves the wrong site or fails certificate issuance.
#AUSTRO_PUBLIC_HOSTNAME=app.example.com

# OPTIONAL — Caddy automatic TLS. Selecting the `caddy` compose profile (instead
# of the nginx reverse-proxy service) enables ACME. The ACME account contact
# address is CONFIGURATION REQUIRED when the caddy profile is used.
#AUSTRO_ACME_EMAIL=ops@example.com

# OPTIONAL — the host ports the proxy publishes. SAFE DEFAULTS 80 and 443.
# Port 80 must stay reachable for the HTTP->HTTPS redirect and for ACME HTTP-01.
# These are the ONLY ports a production deployment should expose publicly.
#AUSTRO_HTTP_PORT=80
#AUSTRO_HTTPS_PORT=443

# NOT SUPPORTED as environment variables: the proxy's request-body limit and
# upstream timeouts. nginx does not read environment variables and the shipped
# configuration is not templated, so these are set in the config files directly
# (the body limit is 2m in deploy/nginx/nginx.conf and 2MB in
# deploy/caddy/Caddyfile). Advertising them here as variables would be a knob
# that does nothing.

# OPTIONAL — select the reverse proxy implementation. SAFE DEFAULT reverse-proxy
# (nginx, operator-supplied certificates). Set to reverse-proxy-caddy to use the
# automatic-TLS variant, which also requires AUSTRO_PUBLIC_HOSTNAME and
# AUSTRO_ACME_EMAIL.
#AUSTRO_PROXY_SERVICE=reverse-proxy

# OPTIONAL — the compose/env file the operator scripts read. SAFE DEFAULT
# .env.production.
#AUSTRO_ENV_FILE=.env.production

# OPTIONAL — scripts/healthcheck.sh skips the proxy checks when set to 1. Used by
# CI smoke runs that bring up the stack without a proxy. SAFE DEFAULT 0.
#AUSTRO_HEALTHCHECK_SKIP_PROXY=0

# BACKUPS — OPTIONAL. Local backup directory (HOST path) and retention.
# SAFE DEFAULTS ./backups and 14 days.
#AUSTRO_BACKUP_DIR=./backups
#AUSTRO_BACKUP_RETENTION_DAYS=14

# BACKUPS — CONFIGURATION REQUIRED to enable off-host copies. S3 upload is
# attempted ONLY when a bucket is explicitly configured; when it is unset the
# backup stays local and the script says so. Requires the `aws` CLI on the host.
#AUSTRO_BACKUP_S3_BUCKET=
#AUSTRO_BACKUP_S3_PREFIX=austro-os/
#OPTIONAL AWS region for the upload; the AWS CLI also reads AWS_REGION.
#AUSTRO_BACKUP_S3_REGION=

# RESTORE — OPTIONAL. scripts/restore.sh refuses to run destructively unless
# this is exactly `yes`. It exists so an unattended run cannot wipe a database
# by accident.
#AUSTRO_RESTORE_CONFIRM=no
