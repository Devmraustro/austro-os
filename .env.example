# AUSTRO OS Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit actual secrets to version control

# Server configuration
AUSTRO_SERVER_ADDR=0.0.0.0:8080

# PostgreSQL configuration
AUSTRO_POSTGRES_DSN=postgres://austro:austro@localhost:5432/austro?sslmode=disable

# Redis configuration
AUSTRO_REDIS_ADDR=localhost:6379
AUSTRO_REDIS_PASSWORD=change-me

# RabbitMQ configuration
AUSTRO_RABBITMQ_URL=amqp://austro:austro@localhost:5672

# JWT authentication
AUSTRO_JWT_SECRET=change-me-in-production-min-32-chars
AUSTRO_JWT_REFRESH_SECRET=change-me-in-production-min-32-chars

# Environment
AUSTRO_ENV=development

# ---------------------------------------------------------------------------
# External service adapters (integration boundaries)
# ---------------------------------------------------------------------------
# These select the adapter used at each integration boundary. The default
# values below run fully offline (deterministic, no external calls, no
# credentials). Selecting a real backend is CONFIGURATION_REQUIRED: the
# corresponding settings must be supplied securely or startup fails fast
# (LoadStrict). NEVER commit real credentials; provide them through the secret
# manager / deployment environment.

# AI provider boundary
#   stub              -> offline deterministic adapter (default, no config needed)
#   local             -> keyless OpenAI-compatible endpoint (model + base url
#                        required; api key OPTIONAL - a locally hosted or
#                        in-house model server usually needs no credential, so
#                        the whole system stays runnable with no paid account)
#   openai-compatible -> real OpenAI-compatible HTTP endpoint (model/base url/
#                        api key required and CONFIGURATION_REQUIRED)
AUSTRO_AI_BACKEND=stub
# AUSTRO_AI_MODEL=
# AUSTRO_AI_BASE_URL=
# AUSTRO_AI_API_KEY=
# Optional per-workspace cap on AI operations (0 = no ceiling)
# AUSTRO_AI_USAGE_LIMIT_PER_WORKSPACE=0

# Publishing delivery boundary
#   stub        -> offline deterministic adapter (default, no config needed)
#   generic-http -> real generic HTTP delivery endpoint (webhook url/token
#                   required and CONFIGURATION_REQUIRED)
AUSTRO_PUBLISH_BACKEND=stub
# AUSTRO_PUBLISH_WEBHOOK_URL=
# AUSTRO_PUBLISH_TOKEN=
